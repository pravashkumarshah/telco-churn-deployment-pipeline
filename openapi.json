{
  "openapi": "3.1.0",
  "info": {
    "title": "Telecom Churn Prediction API",
    "description": "Secure churn scoring service with versioned sklearn pipeline and validation-selected business-cost threshold.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "tags": [
          "prediction"
        ],
        "summary": "Predict",
        "operationId": "predict_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerFeatures"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/predict/batch": {
      "post": {
        "tags": [
          "prediction"
        ],
        "summary": "Predict Batch",
        "operationId": "predict_batch_predict_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchPredictionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchPredictionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/drift/check": {
      "post": {
        "tags": [
          "monitoring"
        ],
        "summary": "Drift Check",
        "operationId": "drift_check_drift_check_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DriftCheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "BatchPredictionRequest": {
        "properties": {
          "customers": {
            "items": {
              "$ref": "#/components/schemas/CustomerFeatures"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Customers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "customers"
        ],
        "title": "BatchPredictionRequest"
      },
      "BatchPredictionResponse": {
        "properties": {
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/PredictionResponse"
            },
            "type": "array",
            "title": "Predictions"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          }
        },
        "type": "object",
        "required": [
          "predictions",
          "count",
          "model_version"
        ],
        "title": "BatchPredictionResponse"
      },
      "CustomerFeatures": {
        "properties": {
          "gender": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Gender"
          },
          "SeniorCitizen": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "title": "Seniorcitizen"
          },
          "Partner": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Partner"
          },
          "Dependents": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Dependents"
          },
          "tenure": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Tenure"
          },
          "PhoneService": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Phoneservice"
          },
          "MultipleLines": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Multiplelines"
          },
          "InternetService": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Internetservice"
          },
          "OnlineSecurity": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Onlinesecurity"
          },
          "OnlineBackup": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Onlinebackup"
          },
          "DeviceProtection": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Deviceprotection"
          },
          "TechSupport": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Techsupport"
          },
          "StreamingTV": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Streamingtv"
          },
          "StreamingMovies": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Streamingmovies"
          },
          "Contract": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Contract"
          },
          "PaperlessBilling": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Paperlessbilling"
          },
          "PaymentMethod": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Paymentmethod"
          },
          "MonthlyCharges": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Monthlycharges"
          },
          "TotalCharges": {
            "type": "string",
            "maxLength": 40,
            "title": "Totalcharges"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "gender",
          "SeniorCitizen",
          "Partner",
          "Dependents",
          "tenure",
          "PhoneService",
          "MultipleLines",
          "InternetService",
          "OnlineSecurity",
          "OnlineBackup",
          "DeviceProtection",
          "TechSupport",
          "StreamingTV",
          "StreamingMovies",
          "Contract",
          "PaperlessBilling",
          "PaymentMethod",
          "MonthlyCharges",
          "TotalCharges"
        ],
        "title": "CustomerFeatures",
        "description": "One CRM record; unknown category strings are allowed intentionally."
      },
      "DriftCheckRequest": {
        "properties": {
          "recent_customers": {
            "items": {
              "$ref": "#/components/schemas/CustomerFeatures"
            },
            "type": "array",
            "maxItems": 1000,
            "minItems": 20,
            "title": "Recent Customers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "recent_customers"
        ],
        "title": "DriftCheckRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PredictionResponse": {
        "properties": {
          "churn_probability": {
            "type": "number",
            "title": "Churn Probability"
          },
          "churn": {
            "type": "boolean",
            "title": "Churn"
          },
          "threshold": {
            "type": "number",
            "title": "Threshold"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "recommendation": {
            "type": "string",
            "title": "Recommendation"
          }
        },
        "type": "object",
        "required": [
          "churn_probability",
          "churn",
          "threshold",
          "model_version",
          "recommendation"
        ],
        "title": "PredictionResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}